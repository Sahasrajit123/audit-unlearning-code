{
  "experiment": {
    "run_folder": "runs_ascent_descent",
    "num_runs": 50,
    "forget_prob": 0.5,
    "strategy": "ascent_descent",
    "dataset": "data_splits_speakers300_fs10"
  },

  "data": {
    "path": "shakespeare.txt",
    "train_frac": 0.8,
    "seq_len": 80
  },

  "model": {
    "embed_dim": 8,
    "hidden_size": 256,
    "num_layers": 2
  },

  "training": {
    "epochs": 15,
    "batch_size": 256,
    "lr": 0.1,
    "clip": 1.0,
    "optimizer": "sgd",
    "seed": 42,
    "weight_decay": 0.0
  },

  "unlearning": {
    "strategy": "ascent_descent",
    "ascent_descent": {
      "epochs": 10,
      "q": 9,
      "lambda_coef": 0.5,
      "forget_epochs_ratio": 0.5,
      "weight_decay": 0.01
    }
  },

  "generation": {
    "seed_text": "To be, or not to be",
    "n_chars": 300,
    "temperature": 0.8
  }
}
