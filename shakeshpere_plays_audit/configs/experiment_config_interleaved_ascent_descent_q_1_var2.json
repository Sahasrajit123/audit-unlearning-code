    "batch_size": 256,
    "ascent_descent": {
      "epochs": 8,
      "lr": 0.05,
      "weight_decay": 0.00,
      "q": 1,
      "lambda_coef": 0.5,
      "forget_epochs_ratio": 0.875
    }
  },

  "generation": {
    "seed_text": "To be, or not to be",
    "n_chars": 300,
    "temperature": 0.8
  }
