{
  "experiment": {
    "run_folder": "runs_ascent_descent_fs400_q_1_var2",
    "num_runs": 100,
    "forget_prob": 0.5,
    "strategy": "ascent_descent",
    "dataset": "data_splits_speakers300_fs400"
  },

  "model": {
    "embed_dim": 8,
    "hidden_size": 256,
    "num_layers": 2
